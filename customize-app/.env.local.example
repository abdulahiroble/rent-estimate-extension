# RentCast API Configuration
RENTCAST_API_KEY=your_api_key_here

# Mock API Configuration
# Set to 'true' to use mock data for local testing (doesn't consume API quota)
# Set to 'false' or remove to use real RentCast API
NEXT_PUBLIC_USE_MOCK_API=false

# Paywall Bypass Configuration
# Set to 'true' to bypass ExtPay paywall for local testing (simulates paid user)
# Set to 'false' or remove to use real ExtPay payment checks
NEXT_PUBLIC_BYPASS_PAYWALL=false

# Example: Use mock API and bypass paywall for testing
# NEXT_PUBLIC_USE_MOCK_API=true
# NEXT_PUBLIC_BYPASS_PAYWALL=true
