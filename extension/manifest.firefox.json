{
  "name": "RentEst - Instant Rent Estimates",
  "short_name": "RentEst",
  "description": "Get instant rental price estimates for any property in the US. Powered by RentCast's 140M+ property database.",
  "version": "1.0.0",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "{rentest-rent-estimates@extension}"
    }
  },
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "permissions": ["storage", "tabs", "geolocation","nativeMessaging"],
  "content_scripts": [
    {
        "matches": ["https://extensionpay.com/*"],
        "js": ["ExtPay.js"],
        "run_at": "document_start"
    }
],
  "options_ui": {
    "page": "customize.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_icon": {
      "16": "images/logo16.png",
      "32": "images/logo32.png",
      "48": "images/logo48.png"
    },
    "default_title": "RentEst - Get Rent Estimates",
    "default_popup": "customize.html"
  }
}
